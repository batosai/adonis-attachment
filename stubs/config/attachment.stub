import {
  defineConfig,
  LocalFileStorage,
  type InferConverters,
} from '@jrmc/adonis-attachment'

const binaries = {
  // ffmpeg: { command: '/opt/media/bin/ffmpeg', timeout: 15_000 },
  // ffprobe: { command: '/opt/media/bin/ffprobe', timeout: 5_000 },
  // pdftoppm: { command: '/opt/media/bin/pdftoppm' },
  // pdfinfo: { command: '/opt/media/bin/pdfinfo' },
  // soffice: { command: '/opt/media/bin/libreoffice' },
}

/**
 * Attachments are stored locally by default. Lucid, Drive, external queues,
 * custom storage, and read routes can be added as the application needs them.
 */
const attachmentConfig = defineConfig({
  storage: LocalFileStorage.fromApp,
  queue: {
    default: 'memory',
    connections: {
      memory: { driver: 'memory', concurrency: 1 },
    },
  },
  media: {
    binaries,
    // metadataPolicy: { mode: 'deferred', variants: false },
  },
  // converters: {
  //   thumbnail: {
  //     width: 320,
  //     format: 'webp',
  //   },
  // },
})

export default attachmentConfig

declare module '@jrmc/adonis-attachment' {
  interface AttachmentVariants extends InferConverters<typeof attachmentConfig> {}
}
