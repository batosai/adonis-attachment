{{{
  exports({ to: app.configPath('attachment.ts') })
}}}
import drive from '@adonisjs/drive/services/main'
import { AdonisDriveStorage, defineConfig } from '@jrmc/adonis-attachment'

/**
 * Attachments use the configured Drive disk by default. Lucid, external queues,
 * custom storage, and read routes can be added as the application needs them.
 */
export default defineConfig({
  defaultDisk: 'fs',
  storage: new AdonisDriveStorage(drive),
  sources: {
    maxBytes: 10 * 1024 * 1024,
  },
})
